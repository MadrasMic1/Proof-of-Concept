# .env.example - copy to .env and fill in. Never commit .env.
APP_NAME=RIC Backend
APP_VERSION=0.1.0
ENVIRONMENT=local
DEBUG=true

# App connection (async driver). db_bootstrap creates this user and database.
# URL-encode special characters in passwords (@ -> %40, # -> %23).
DATABASE_URL=postgresql+asyncpg://ric_app:change_me@localhost:5432/ric_poc
DB_ECHO=false

# Superuser connection. Used only by scripts/db_bootstrap.py.
ADMIN_DATABASE_URL=postgresql://postgres:your_postgres_password@localhost:5432/postgres

# Logging: LOG_LEVEL is DEBUG, INFO, WARNING or ERROR.
# LOG_FORMAT is console (readable, local) or json (one JSON object per line, Azure).
LOG_LEVEL=INFO
LOG_FORMAT=console

# Comma-separated browser origins allowed to call the API (admin portal, Expo web).
# Leave empty to allow none. "*" is rejected.
CORS_ORIGINS=http://localhost:8081,http://localhost:3000

# Interactive API docs at /docs. Set to false in production.
DOCS_ENABLED=true

# One api_request_log row per API request (health, docs and OPTIONS are skipped).
REQUEST_LOG_ENABLED=true

# --- LLM ------------------------------------------------------------------------------
# Provider: fake (no network, no key), nvidia (NVIDIA NIM), groq, foundry (Azure AI Foundry).
# Switching provider is only these lines; check with: uv run python -m scripts.llm_check
LLM_PROVIDER=nvidia
# Empty = provider default: nvidia -> nvidia/nemotron-3.5-lightning-30b-a3b,
# groq -> openai/gpt-oss-20b. Foundry: your deployment name (required).
LLM_MODEL=
LLM_API_KEY=nvapi-your-key
# Empty = provider default. Foundry (required): https://<resource>.openai.azure.com/openai/v1/
LLM_BASE_URL=
# auto (recommended): nvidia -> json_schema, groq/foundry -> json_object.
# Other values: nvext, json_schema, json_object, none.
LLM_STRUCTURED_OUTPUT=auto
# Free endpoints can be slow: seconds to wait before a call counts as unavailable.
LLM_TIMEOUT_SECONDS=120
LLM_MAX_OUTPUT_TOKENS=2048
# Optional extra request fields as JSON, merged last. Example:
# LLM_EXTRA_BODY={"top_p": 0.9}
LLM_EXTRA_BODY={}

# Optional second provider, used only when the first is unavailable (timeout,
# network error, rate limit, 5xx). none | fake | nvidia | groq | foundry.
# Same provider: the API key above is reused. NVIDIA's free rate limit is shared
# by all models on one key, so a different provider (e.g. groq) helps more with 429s.
LLM_FALLBACK_PROVIDER=nvidia
LLM_FALLBACK_MODEL=openai/gpt-oss-20b
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_BASE_URL=

# true = run tests/test_llm_live.py (one real call). Keep false for normal test runs.
LLM_LIVE_TEST=false

# --- Worker ---------------------------------------------------------------------------
# Run: uv run python -m scripts.worker   (--drain: process everything pending, then stop)
# Free-tier quota: at most this many LLM calls per minute (NVIDIA free tier ~40/min per key).
WORKER_MAX_CALLS_PER_MINUTE=20
# Attempts per journal entry, and minutes to wait between them.
WORKER_MAX_ATTEMPTS=3
WORKER_RETRY_DELAYS_MINUTES=2,10
# After a rate-limit answer (HTTP 429), no LLM call for this many seconds.
WORKER_RATE_LIMIT_PAUSE_SECONDS=60
WORKER_POLL_SECONDS=5
WORKER_SWEEP_SECONDS=60

# --- ITSM (ServiceNow) ----------------------------------------------------------------
ITSM_PROVIDER=servicenow
SERVICENOW_INSTANCE_URL=https://dev445000.service-now.com
SERVICENOW_CLIENT_ID=4bc347385d6e467f898846feeb50258e
SERVICENOW_CLIENT_SECRET=Nc<V#$fC1jZB!#u)s#]rYL:1`9c~p|el
SERVICENOW_DEFAULT_ASSIGNMENT_GROUP=Service Desk

# --- ITSM (GLPI) ----------------------------------------------------------------------
# GLPI is the ITSM of record; RIC keeps its own copy of the incidents (webhooks +
# 15-minute reconciliation, later phases). The names are the same as in
# glpi-poc/.env.api: copy the values from there. GLPI must be running (Docker Desktop).
# Check with: uv run python -m scripts.check_env   and   uv run python -m scripts.itsm_check
ITSM_PROVIDER=glpi
# High-level API V2 (OAuth2 password grant: OAuth client + the ric.api user)
GLPI_V2_URL=http://localhost:8080/api.php/v2
GLPI_OAUTH_TOKEN_URL=http://localhost:8080/api.php/token
GLPI_OAUTH_CLIENT_ID=
GLPI_OAUTH_CLIENT_SECRET=
GLPI_API_USERNAME=ric.api
GLPI_API_PASSWORD=
# Legacy REST API V1 (ETA, linked CI, pending reason): API client app token + ric.api user token
GLPI_V1_URL=http://localhost:8080/apirest.php
GLPI_APP_TOKEN=
GLPI_USER_TOKEN=
# Time zone of GLPI's date/time text (Phase 12 confirmed UTC).
GLPI_TIMEZONE=UTC
GLPI_TIMEOUT_SECONDS=30
# Shared secret of the GLPI webhooks (GLPI_WEBHOOK_SECRET in glpi-poc/.env.api), used from Phase 17.
GLPI_WEBHOOK_SECRET=
# Reconciliation: every 15 minutes, looking back 5 minutes before the last watermark.
ITSM_RECONCILE_INTERVAL_SECONDS=900
ITSM_RECONCILE_OVERLAP_SECONDS=300
# GLPI webhooks into RIC (Phase 17): the RIC API as GLPI (in Docker) reaches it, and limits
# of a delivery. GLPI_WEBHOOK_SECRET above signs every delivery.
ITSM_WEBHOOK_BASE_URL=http://host.docker.internal:8000
ITSM_WEBHOOK_MAX_AGE_SECONDS=86400
ITSM_WEBHOOK_MAX_FUTURE_SECONDS=300
ITSM_WEBHOOK_MAX_BODY_BYTES=1000000
# GLPI sync in the worker (Phase 18): inbox poll, attempts per ticket, seconds before
# attempt 2, 3, ... (last repeats), scheduler poll, days finished inbox rows are kept.
ITSM_SYNC_POLL_SECONDS=5
ITSM_SYNC_MAX_ATTEMPTS=8
ITSM_SYNC_RETRY_DELAYS_SECONDS=30,120,600,1800
ITSM_SCHEDULER_POLL_SECONDS=10
ITSM_INBOX_RETENTION_DAYS=14
# Sync status (Phase 20): oldest due inbox row (minutes), failed reconciliation runs in a row,
# GLPI clock drift warn / fail (seconds, checked by scripts.itsm_status --live).
ITSM_STATUS_MAX_INBOX_AGE_MINUTES=10
ITSM_STATUS_MAX_RECONCILE_FAILURES=3
ITSM_CLOCK_DRIFT_WARN_SECONDS=30
ITSM_CLOCK_DRIFT_FAIL_SECONDS=120

# =====================================================================================
# AGENTIC SYSTEM (app/agentic/config.py). Every value has a safe default; change them
# here, never in code. Check with: uv run python -m scripts.agentic_check_env
# =====================================================================================
# Master switch (the full kill switch comes later).
AGENT_ENABLED=true
# true: a confirmed chat incident is also created in GLPI (if GLPI cannot be reached,
# nothing is created and the manager taps Confirm again). false: RIC-only incident.
AGENT_CONFIRM_TO_GLPI=true

# --- Restricted database logins (created by: uv run python -m scripts.agentic_db_setup)
# The MCP process connects as ric_mcp (no write access to incidents); the KB ingestion
# script as ric_kb_admin. Same host and database as DATABASE_URL, own passwords.
MCP_DATABASE_URL=postgresql+asyncpg://ric_mcp:change_me_mcp@localhost:5432/ric_poc
KB_ADMIN_DATABASE_URL=postgresql+asyncpg://ric_kb_admin:change_me_kb@localhost:5432/ric_poc

# --- Chat gateway ---------------------------------------------------------------------
AGENT_TURN_TIMEOUT_SECONDS=420
# The app's HTTP timeout must be longer than the turn timeout.
AGENT_APP_CLIENT_TIMEOUT_HINT_SECONDS=450
# Signs the token the gateway gives the MCP server. At least 32 characters; required when
# ENVIRONMENT is dev or prod. Generate: uv run python -c "import secrets; print(secrets.token_urlsafe(48))"
AGENT_USER_CONTEXT_TOKEN_SECRET=
AGENT_USER_CONTEXT_TOKEN_ISSUER=ric-gateway
AGENT_USER_CONTEXT_TOKEN_AUDIENCE=ric-mcp
# Must be longer than the turn timeout.
AGENT_USER_CONTEXT_TOKEN_TTL_SECONDS=480
AGENT_TOKEN_CLOCK_SKEW_SECONDS=30
# POC identity: X-User value = role (store_staff | store_manager). Unlisted users are staff.
AGENT_DEV_USER_ROLES=priya.store-manager=store_manager

# --- Agent LLM (separate from the worker's LLM_* settings) ---------------------------
AGENT_LLM_PROVIDER=nvidia
AGENT_LLM_BASE_URL=
# Empty: LLM_API_KEY is reused when the provider is the same.
AGENT_LLM_API_KEY=
# Empty: the provider's default model. Foundry: your deployment name.
AGENT_MODEL_ORCHESTRATOR=
AGENT_MODEL_SPECIALIST=
AGENT_MODEL_SUMMARISER=
AGENT_LLM_TIMEOUT_SECONDS=90
AGENT_LLM_MAX_RETRIES=2
AGENT_LLM_MAX_OUTPUT_TOKENS=2048
# none | fake | nvidia | groq | foundry
AGENT_FALLBACK_PROVIDER=none
AGENT_FALLBACK_MODEL=
AGENT_FALLBACK_API_KEY=
AGENT_FALLBACK_BASE_URL=
AGENT_FALLBACK_TIMEOUT_SECONDS=180
AGENT_TEMPERATURE_ORCHESTRATOR=0.1
AGENT_TEMPERATURE_SPECIALIST=0.0
# true = run tests/agentic/test_agent_live.py (one real agent run). Keep false normally.
AGENT_LIVE_TEST=false

# --- Session memory -------------------------------------------------------------------
AGENT_SESSION_IDLE_MINUTES=30
AGENT_MEMORY_VERBATIM_TURNS=6
AGENT_MEMORY_HARD_CAP_TURNS=10
AGENT_MEMORY_SUMMARY_MAX_TOKENS=300
AGENT_MESSAGE_RETENTION_DAYS=30

# --- Orchestrator and specialists -----------------------------------------------------
# Model calls must exceed specialist calls (one per specialist call + the final answer).
AGENT_ORCH_MAX_MODEL_CALLS=12
AGENT_ORCH_MAX_SPECIALIST_CALLS=5
AGENT_ORCH_MAX_CALLS_PER_SPECIALIST=3
AGENT_SPECIALIST_MAX_MODEL_CALLS=8
# Must be below the turn timeout.
AGENT_SPECIALIST_TIMEOUT_SECONDS=240
AGENT_MAX_SUGGESTED_REPLIES=3
AGENT_TOOL_TIMEOUT_SECONDS=30

# --- Store context and store graph ----------------------------------------------------
STORE_CTX_STALE_AFTER_MINUTES=15
# true: a device without a heartbeat for the minutes above counts as unknown. Keep false
# with seeded data (heartbeats are fixed at seed time).
STORE_CTX_STALE_CHECK=false
STORE_CTX_SNAPSHOT_MAX_TOKENS=800
STORE_CTX_QUERY_TIMEOUT_SECONDS=5
STORE_CTX_MAX_DEVICE_LINES=8
STORE_CTX_MAX_INCIDENT_LINES=5
STORE_CTX_APPOINTMENT_LOOKAHEAD_HOURS=48
STORE_CTX_RECENT_RESOLVED_HOURS=24
STORE_GRAPH_CATALOGUE_PATH=config/element_catalogue.yaml
STORE_GRAPH_MAX_DEPTH=6
STORE_GRAPH_COMMON_CAUSE_MIN=3
STORE_GRAPH_COMMON_CAUSE_WINDOW_MINUTES=15

# --- Store Insight agent --------------------------------------------------------------
STORE_INSIGHT_MAX_TOOL_CALLS=10
STORE_INSIGHT_MAX_CAUSES=3
STORE_INSIGHT_HISTORY_LOOKBACK_HOURS=6
STORE_INSIGHT_FLAP_THRESHOLD=3
STORE_INSIGHT_MAX_DEVICE_OPTIONS=3
STORE_INSIGHT_VALIDATOR_REPAIR_ATTEMPTS=1
STORE_INSIGHT_TOOL_RETRY=1

# --- KB Guide and KB ingestion --------------------------------------------------------
KB_SEARCH_TOP_K=5
KB_SEARCH_MIN_SCORE=0.55
KB_SEARCH_RRF_K=60
KB_MAX_CANDIDATES_SHOWN=3
KB_GUIDE_MAX_CLARIFICATIONS=2
KB_GUIDE_ABANDON_MINUTES=30
KB_GUIDE_MAX_TOOL_CALLS=6
KB_GUIDE_TOOL_RETRY=1
KB_ARTICLES_PATH=kb/articles
# none (tags + full-text search only) | fake | nvidia | foundry
KB_EMBEDDING_PROVIDER=none
KB_EMBEDDING_BASE_URL=
KB_EMBEDDING_API_KEY=
KB_EMBEDDING_MODEL=
# Fixed by migration 0005; another value needs a new migration and a full re-ingest.
KB_EMBEDDING_DIM=1536
KB_EMBEDDING_BATCH_SIZE=32
# Size asked from the embedding API (<= 1536). NVIDIA: 1024. Empty: the model's own size
# (Foundry text-embedding-3-small = 1536). Changing it needs: scripts.kb_ingest --publish --reembed
KB_EMBEDDING_REQUEST_DIM=
KB_EMBEDDING_TIMEOUT_SECONDS=60
KB_INSTRUCTION_MAX_CHARS=300
KB_ASK_MAX_CHARS=120
KB_LABEL_MAX_CHARS=30
KB_RETIRED_KEEP_DAYS=30

# --- Incident Desk, drafts and confirmations -------------------------------------------
INCIDENT_DRAFT_TTL_MINUTES=15
INCIDENT_DUP_LOOKBACK_HOURS=24
INCIDENT_DUP_TEXT_MIN_SCORE=0.75
INCIDENT_IMPACT_HIGH_MIN_NODES=5
INCIDENT_SUBJECT_MAX_CHARS=80
INCIDENT_DESCRIPTION_MAX_CHARS=2000
# Levels (1-3 scale) the model may move impact / urgency away from the rule baseline.
INCIDENT_IMPACT_MAX_DEVIATION=1
INCIDENT_URGENCY_MAX_DEVIATION=1
INCIDENT_APPEND_EVIDENCE_BLOCK=true
INCIDENT_DESK_MAX_TOOL_CALLS=6
INCIDENT_DESK_TOOL_RETRY=1

# --- MCP server -------------------------------------------------------------------------
MCP_HOST=127.0.0.1
MCP_PORT=8100
MCP_URL=http://127.0.0.1:8100/mcp
MCP_DB_POOL_SIZE=5
MCP_DB_MAX_OVERFLOW=5
MCP_DB_POOL_TIMEOUT_SECONDS=5
MCP_DB_STATEMENT_TIMEOUT_MS=5000
MCP_TOOL_TIMEOUT_SECONDS=30
MCP_TOOL_POLICY_PATH=config/tool_policy.yaml
MCP_RATE_LIMIT_PER_SESSION_PER_MINUTE=60
MCP_MAX_IDENTICAL_CALLS_PER_RUN=2
MCP_MAX_DRAFTS_PER_SESSION_PER_HOUR=5
MCP_MAX_FINDINGS=10
MCP_MAX_HISTORY_EVENTS=50
MCP_MAX_INCIDENT_RESULTS=10
MCP_MAX_TEXT_FIELD_CHARS=1000
MCP_MAX_PUBLIC_UPDATES=3
MCP_ENABLE_LINK_METRICS=false
